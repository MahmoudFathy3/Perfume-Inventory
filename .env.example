# ============================================================
# إعدادات التطبيق (بتتقرأ وقت الـ build، يعني بعد أي تعديل شغّل npm run dev / npm run dist تاني)
#   MAIN_VITE_     = إعدادات الـ backend (Electron)
#   RENDERER_VITE_ = إعدادات الواجهة
# ============================================================

# اسم ملف الداتا بيز (بيتحفظ جوه فولدر بيانات التطبيق)
MAIN_VITE_DB_FILE_NAME=perfume-inventory.sqlite

# اسم التطبيق (عنوان النوافذ) بالإنجليزي والعربي
MAIN_VITE_APP_NAME=Perfume Inventory
MAIN_VITE_APP_NAME_AR=مخزن العطور

# مدة ظهور شاشة البداية بالميلي ثانية (3000 = 3 ثواني)
MAIN_VITE_SPLASH_DURATION_MS=3000

# عملة العرض (كود ISO مثل EGP / SAR / AED / USD)
RENDERER_VITE_CURRENCY=EGP

# لغة التطبيق في أول تشغيل (ar أو en)
RENDERER_VITE_DEFAULT_LANGUAGE=ar

# بيانات المطوّر (بتظهر في الإعدادات ← عن المطوّر). الفاضي بيتخفي.
RENDERER_VITE_DEVELOPER_NAME=Mahmoud Fathy
RENDERER_VITE_DEVELOPER_PHONE=01001387292
RENDERER_VITE_DEVELOPER_EMAIL=MahmoudFathy1997@hotmail.com
